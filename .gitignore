.claude/settings.local.json

# Release artifacts and secrets (never commit)
*.dmg
*.p12
*.p8
*.pem
*.key
*.xcarchive
*.cer
*.mobileprovision
*.provisionprofile
.env

# Per-developer signing team (Config/Local.xcconfig.example)
Config/Local.xcconfig

# Website (site/): dependencies, build output and files the build regenerates
site/node_modules/
site/dist/
site/.tanstack/
site/.lighthouseci/
site/src/fonts/
.vercel/
