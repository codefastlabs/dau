#!/bin/zsh
# Git pre-commit hook: refuses a commit while scripts/check-docs/check.sh fails.
# Side effects: none
#
# Turn it on once per clone: git config core.hooksPath .githooks
# The check reads the working tree, not the index: with a partial commit it can pass or
# fail on changes that are not part of the commit.
set -uo pipefail
root=$(git rev-parse --show-toplevel) || exit 1
exec "$root/scripts/check-docs/check.sh"
